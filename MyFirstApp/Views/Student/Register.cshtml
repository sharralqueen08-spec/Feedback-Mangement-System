
@model MyFirstApp.Models.Student


<div class="form-container p-5">
    <div class="container flex-column flex-md-row justify-content-center align-items-center">
        <div class="row justify-content-center card p-5">
            <div class="col-lg-6 col-md-8">

                <div class="registration-card">

                    <div class="form-header text-center">
                        <h2>Student Registration</h2>
                        <p>Fill in your details to register</p>
                    </div>

                    <form method="post">

                        <!-- Student Name -->
                        <div class="mb-4">
                            <label class="form-label">Student Name</label>
                            <input type="text" name="StudentName" class="form-control"
                                   placeholder="Enter your full name" required>
                            <span asp-validation-for="StudentName" class="text-danger"></span>
                        </div>

                        <!-- Student ID -->
                        <div class="mb-4">
                            <label class="form-label">Student ID</label>
                            <input type="text" name="StudentId" class="form-control"
                                   placeholder="Enter your student ID" required>
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        </div>

                        <!-- Course -->
                        <div class="mb-4">
                            <label class="form-label">Select Course</label>
                            <select class="form-select" required name="Course">
                                <option value="none" selected disabled>Choose your course</option>
                                <option value="Web Development">Web Development</option>
                                <option value="Graphic Designing">Graphic Designing</option>
                                <option value="App Development">App Development</option>
                                <option value="Cyber Security">Cyber Security</option>
                                <option value="Data Science">Data Science</option>
                            </select>
                            <span asp-validation-for="Course" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" class="form-control"
                                   placeholder="example@gmail.com" required>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Button -->
                        <div class="d-grid">
                            <button type="submit" name="submit" class="btn register-btn">
                                Register Now
                            </button>

                            <a asp-action="Register" asp-controller="Student" class="btn-outline-light-custom"
                             <i class="bi bi-people" ></i>
                              Quickly
                                </button>
                            </div>

                    </form>

                </div>

                    <p class="footer-text text-center mt-4">
                        © 2026 Student Registration Portal
                    </p>

                </div>

            </div>
        </div>
    </div>
</div>

