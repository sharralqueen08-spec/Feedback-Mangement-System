
<!-- HERO BANNER -->
<header class="contact-hero" id="top">
    <div class="hero-content">
        <span class="hero-tag">
            <i class="bi bi-chat-dots me-2"></i> Let's Connect
        </span>

        <h1>Get In <span>Touch.</span></h1>

        <p>
            Have a question, an idea, or a project in mind?
            We'd love to hear from you. Let's start a conversation
            and create something meaningful together.
        </p>

        <div class="breadcrumb-custom">
            <a href="#">Home</a>
            <i class="bi bi-chevron-right mx-2"></i>
            Contact Us
        </div>
    </div>
</header>

<!-- CONTACT INFO + FEEDBACK FORM -->
<section class="contact-section" id="contact">
    <div class="container">
        <div class="row align-items-start g-4">

            <!-- LEFT: CONTACT DETAILS -->
            <div class="col-lg-5">
                <div class="contact-info reveal reveal-left">

                    <span class="section-label">
                        Contact Information
                    </span>

                    <h2 class="section-heading">
                        Let's make your<br>
                        next idea <span style="color:#198754">happen.</span>
                    </h2>

                    <p class="section-description">
                        We're always happy to connect with you.
                        Reach out through any of the options below, and
                        we'll be glad to hear what you have in mind.
                    </p>

                    <!-- EMAIL CARD -->
                    <div class="info-card">
                        <div class="info-icon">
                            <i class="bi bi-envelope"></i>
                        </div>

                        <div>
                            <h6>Email Us</h6>
                            <a href="mailto:hello@example.com">
                                hello@example.com
                            </a>
                        </div>
                    </div>

                    <!-- PHONE CARD -->
                    <div class="info-card">
                        <div class="info-icon">
                            <i class="bi bi-telephone"></i>
                        </div>

                        <div>
                            <h6>Call Us</h6>
                            <a href="tel:+923001234567">
                                +92 300 1234567
                            </a>
                        </div>
                    </div>

                    <!-- LOCATION CARD -->
                    <div class="info-card">
                        <div class="info-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>

                        <div>
                            <h6>Our Location</h6>
                            <p>Hyderabad, Sindh, Pakistan</p>
                        </div>
                    </div>

                    <!-- SOCIAL LINKS -->
                    <h5 class="social-heading">
                        Follow us on social media
                    </h5>

                    <div class="social-links">
                        <a href="https://facebook.com/"
                           target="_blank" rel="noopener noreferrer"
                           aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="https://instagram.com/"
                           target="_blank" rel="noopener noreferrer"
                           aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="https://linkedin.com/"
                           target="_blank" rel="noopener noreferrer"
                           aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>

                        <a href="https://x.com/"
                           target="_blank" rel="noopener noreferrer"
                           aria-label="X">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                        <a href="https://wa.me/923001234567"
                           target="_blank" rel="noopener noreferrer"
                           aria-label="WhatsApp">
                            <i class="bi bi-whatsapp"></i>
                        </a>
                    </div>

                </div>
            </div>

            <!-- RIGHT: FEEDBACK FORM -->
            <div class="col-lg-7">
                <div class="feedback-card reveal reveal-right">

                    <span class="section-label">
                        Send a Message
                    </span>

                    <h3 class="form-title">
                        We'd love your feedback.
                    </h3>

                    <p class="form-intro">
                        Fill out the form below and tell us how we can help.
                        All fields marked with * are required.
                    </p>

                    <form id="feedbackForm">

                        <!-- FULL NAME + EMAIL -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="fullname" class="form-label">
                                    Full Name *
                                </label>
                                <input type="text" class="form-control"
                                       id="fullname" name="fullname"
                                       placeholder="Enter your full name"
                                       autocomplete="name" required
                                       maxlength="100">
                            </div>

                            <div class="col-md-6">
                                <label for="email" class="form-label">
                                    Email Address *
                                </label>
                                <input type="email" class="form-control"
                                       id="email" name="email"
                                       placeholder="you@example.com"
                                       autocomplete="email" required
                                       maxlength="254">
                            </div>

                            <!-- PHONE + SUBJECT -->
                            <div class="col-md-6">
                                <label for="phone" class="form-label">
                                    Phone Number
                                </label>
                                <input type="tel" class="form-control"
                                       id="phone" name="phone"
                                       placeholder="+92 300 1234567"
                                       autocomplete="tel"
                                       maxlength="25">
                            </div>

                            <div class="col-md-6">
                                <label for="subject" class="form-label">
                                    Subject *
                                </label>
                                <input type="text" class="form-control"
                                       id="subject" name="subject"
                                       placeholder="How can we help?"
                                       required maxlength="150">
                            </div>

                            <!-- MESSAGE -->
                            <div class="col-12">
                                <label for="message" class="form-label">
                                    Your Message *
                                </label>
                                <textarea class="form-control"
                                          id="message" name="message"
                                          placeholder="Write your message here..."
                                          required maxlength="3000"></textarea>
                            </div>

                            <!-- SUBMIT BUTTON -->
                            <div class="col-12">
                                <button type="submit" class="submit-btn">
                                    Send Your Message
                                    <i class="bi bi-arrow-right"></i>
                                </button>

                                <p class="privacy-note">
                                    <i class="bi bi-shield-check"></i>
                                    Your information should be handled securely.
                                </p>

                                <div id="formStatus"
                                     class="mt-3 small"
                                     role="status"
                                     aria-live="polite"></div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- MAP SECTION -->
<section class="map-section" id="location">
    <div class="container">

        <div class="map-heading reveal">
            <span class="section-label">
                Find Us
            </span>

            <h2 class="section-heading">
                We're just a map away.
            </h2>

            <p class="section-description mb-0">
                Explore the map below to view our sample location.
                Replace it with your actual business address whenever
                you're ready to publish your website.
            </p>
        </div>

        <div class="map-wrapper reveal">
            <iframe src="https://maps.google.com/maps?q=Hyderabad%2C%20Sindh%2C%20Pakistan&z=12&output=embed"
                    title="Map showing Hyderabad, Sindh, Pakistan"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen>
            </iframe>
        </div>

    </div>
</section>


<!-- Add this script once, after the page content (ideally before </body>). -->
<script>
    (function () {
        // Enable animated reveals only after JavaScript is running.
        document.documentElement.classList.add('js');

        var revealItems = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
            revealItems.forEach(function (item) { item.classList.add('show'); });
            return;
        }

        var observer = new IntersectionObserver(function (entries, currentObserver) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('show');
                    currentObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.08, rootMargin: '0px 0px 60px 0px' });

        revealItems.forEach(function (item) { observer.observe(item); });
    })();
</script>

